HOST=0.0.0.0
PORT=1337
CORS_ORIGINS=https://maisonjla.lafabriqueducode.fr,https://maisonjla.fr,https://www.maisonjla.fr

# ── Secrets Strapi (obligatoires) ───────────────────────────────────────────
# Générer chaque valeur aléatoirement, par exemple :
#   openssl rand -base64 32
# APP_KEYS accepte plusieurs clés séparées par des virgules (rotation).
APP_KEYS=remplacer_par_une_cle_aleatoire_1,remplacer_par_une_cle_aleatoire_2
ADMIN_JWT_SECRET=remplacer_par_une_cle_aleatoire
API_TOKEN_SALT=remplacer_par_une_cle_aleatoire
TRANSFER_TOKEN_SALT=remplacer_par_une_cle_aleatoire
ENCRYPTION_KEY=remplacer_par_une_cle_aleatoire

# ── Base de données ────────────────────────────────────────────────────────
# En production, ces variables n'ont plus de valeur par défaut : un démarrage
# sans DATABASE_NAME / DATABASE_USERNAME / DATABASE_PASSWORD échoue
# volontairement (les identifiants publics « strapi » ne sont plus acceptés).
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=remplacer_par_le_mot_de_passe_de_la_base
# Passer à true lorsque la base est distante ou exposée sur un réseau partagé.
DATABASE_SSL=false

# ── Jeton de commande (contrôle d'accès par ressource) ─────────────────────
# compat : les appels sans jeton de commande sont journalisés mais acceptés
#          (déploiement progressif, le temps que le front transmette le jeton).
# strict : tout accès à une commande sans son jeton est refusé (403).
# off    : contrôle désactivé (interrupteur de secours).
# À passer en strict après déploiement du front qui transmet le jeton.
ORDER_ACCESS_ENFORCEMENT=compat
CLOUDFLARE_R2_MEDIA_ENDPOINT=https://votre_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_MEDIA_ACCESS_KEY_ID=votre_access_key_id_r2_media
CLOUDFLARE_R2_MEDIA_SECRET_ACCESS_KEY=votre_secret_access_key_r2_media
CLOUDFLARE_R2_MEDIA_BUCKET=maison-jla-media
# URL publique r2.dev fournie par Cloudflare après activation (pas de DNS à configurer).
CLOUDFLARE_R2_MEDIA_PUBLIC_URL=https://pub-votre-identifiant.r2.dev
# Bucket R2 privé dédié aux factures : ne jamais configurer de domaine public.
CLOUDFLARE_R2_ACCOUNT_ID=votre_account_id_cloudflare
CLOUDFLARE_R2_ACCESS_KEY_ID=votre_access_key_id_r2
CLOUDFLARE_R2_SECRET_ACCESS_KEY=votre_secret_access_key_r2
CLOUDFLARE_R2_INVOICES_BUCKET=maison-jla-invoices
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Maison JLA <bonjour@votre-domaine.fr>
RESEND_REPLY_TO=bonjour@votre-domaine.fr
NTFY_TOPIC_URL=https://ntfy.sh/votre-topic-prive
NTFY_TOKEN=votre_jeton_ntfy_optionnel
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDCLOUD_PUBLIC_KEY=VOTRE_CLE_PUBLIQUE_SENDCLOUD
SENDCLOUD_SECRET_KEY=VOTRE_CLE_SECRETE_SENDCLOUD
SENDCLOUD_INTEGRATION_ID=VOTRE_IDENTIFIANT_INTEGRATION_SENDCLOUD
