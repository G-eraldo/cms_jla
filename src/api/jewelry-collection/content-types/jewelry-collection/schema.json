{
  "kind": "collectionType",
  "collectionName": "jewelry_collections",
  "info": {
    "singularName": "jewelry-collection",
    "pluralName": "jewelry-collections",
    "displayName": "Collection de bijoux"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "banner": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "collections"
    }
  }
}
